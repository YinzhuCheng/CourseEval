APP_NAME=Notebook Runner MVP
SECRET_KEY=replace-with-a-long-random-string
DEBUG=false
DEFAULT_LOCALE=en
TIMEZONE_NAME=Asia/Shanghai
APP_BASE_URL=http://localhost:8000
REGISTRATION_INVITE_CODE=
INTERNAL_EMAIL_DOMAIN=invite.local
EMAIL_VERIFICATION_EXPIRE_HOURS=24

DATABASE_URL=sqlite:////workspace/data/app.db
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=notebook-jobs

UPLOAD_MAX_BYTES=5242880
EXECUTION_TIMEOUT_SECONDS=300

RUNNER_IMAGE=notebook-runner-mvp:latest
RUNNER_MEMORY_LIMIT=1g
RUNNER_CPUS=1
DOCKER_NETWORK_DISABLED=true

DATA_DIR=data

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=CourseEval
SMTP_STARTTLS=true
SMTP_USE_SSL=false
